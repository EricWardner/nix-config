# screenshot: capture, then choose in the preview: Copy, or Save… (a save
# dialog starting in ~/Pictures/Screenshots), Annotate or Discard. Until
# then the shot is only in $XDG_RUNTIME_DIR/screenshot.
#
#   screenshot area     Print: drag a region or click a window, the screen
#                       frozen while you choose
#   screenshot window   Shift+Print: the focused window, all of it even where
#                       it's covered
#   screenshot output   Ctrl+Print: the focused monitor
#   screenshot text     Super+Print: the text in a region, or a QR code's
#                       contents, copied as text
#   screenshot color    Super+Shift+Print: a pixel's colour, copied as hex
#   screenshot menu [PNG]
#                       a saved screenshot's preview, with annotate (Satty),
#                       copy, show in folder and delete (the newest by default)

dir="$HOME/Pictures/Screenshots"
shots="${XDG_RUNTIME_DIR:-/tmp}/screenshot"

notify() {
  notify-send -a Screenshot "$@"
}

# The notification server reads a body as markup
escape() {
  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

menu() {
  local file=${1:-}
  if [ -z "$file" ]; then
    file=$(find "$dir" -maxdepth 1 -name '*.png' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
  fi
  if [ ! -f "$file" ]; then
    notify -t 3000 "Screenshot not found" "${file:-No screenshots in ~/Pictures/Screenshots}"
    return 1
  fi
  capture-preview "$file" || true
}

shot() {
  mkdir -p "$shots"
  # Shots left from earlier (copied, or open in Satty): Satty has read them
  # long since, and wl-copy holds its own copy
  find "$shots" -maxdepth 1 -name '*.png' -mmin +60 -delete
  local stamp file n=1
  stamp=$(date +%m-%d-%Y-%H-%M-%S)
  file="$shots/$stamp.png"
  while [ -e "$file" ]; do
    n=$((n + 1))
    file="$shots/$stamp-$n.png"
  done
  # grimblast runs grim, slurp and hyprpicker (the freeze)
  grimblast --freeze save "$1" "$file" >/dev/null 2>&1 || true
  # Nothing saved: the selection was cancelled
  [ -s "$file" ] || exit 0
  capture-preview --save-dir "$dir" "$file" || true
}

text() {
  local img out kind
  img=$(mktemp --suffix=.png)
  trap 'rm -f "$img"' EXIT
  # At 3x the logical size: tesseract reads small UI text better than at
  # the monitors' own 1.25x and 1.6x
  grimblast --freeze --scale 3 save area "$img" >/dev/null 2>&1 || true
  [ -s "$img" ] || exit 0
  if out=$(qrtool decode "$img" 2>/dev/null) && [ -n "$out" ]; then
    kind="QR code"
  else
    out=$(tesseract "$img" - 2>/dev/null | tr -d '\f') || true
    kind=Text
  fi
  if [ -z "${out//[[:space:]]/}" ]; then
    notify -t 3000 "No text found"
    exit 0
  fi
  printf '%s' "$out" | wl-copy
  notify -t 6000 "$kind copied" "$(head -n 4 <<<"$out" | cut -c1-80 | escape)"
}

color() {
  local hex swatch
  # hyprpicker freezes the screen under a zoom lens; -a copies the colour
  hex=$(hyprpicker --autocopy --format=hex --lowercase-hex --no-fancy --quiet 2>/dev/null) || true
  [ -n "$hex" ] || exit 0
  swatch="${XDG_RUNTIME_DIR:-/tmp}/screenshot-swatch.svg"
  printf '<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64"><rect width="64" height="64" rx="14" fill="%s"/></svg>\n' "$hex" >"$swatch"
  notify -t 5000 -i "$swatch" "Colour copied" "$hex"
}

case ${1:-} in
  area | window | output)
    target=$1
    [ "$target" = window ] && target=active
    shot "$target"
    ;;
  text) text ;;
  color) color ;;
  menu) menu "${2:-}" ;;
  *)
    echo "usage: screenshot area | window | output | text | color | menu [PNG]" >&2
    exit 2
    ;;
esac
