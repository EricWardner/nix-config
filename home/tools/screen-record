# screen-record: record an area to an MP4 and a GIF in ~/Videos.
#
#   screen-record        start (select, count down, record), or stop or
#                        cancel the recording in progress: Super+R and the
#                        bar's record button
#   screen-record click  the bar's status module: the same, except that a
#                        finished recording opens its menu
#   screen-record menu [GIF]
#                        show in folder, copy, open or delete (the newest
#                        GIF by default)
#
# The state for the bar (bar-tools record-watch) is one line in
# $XDG_RUNTIME_DIR/screen-record/state, replaced by rename.

dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/screen-record"
mkdir -p "$dir"

set_state() {
  printf '%s\n' "$*" > "$dir/.state"
  mv "$dir/.state" "$dir/state"
}

get_state() {
  cat "$dir/state" 2>/dev/null || echo idle
}

notify() {
  notify-send -a "Screen recording" "$@"
}

menu() {
  local gif=${1:-}
  if [ -z "$gif" ]; then
    gif=$(find "$HOME/Videos" -maxdepth 1 -name '*.gif' -printf '%T@ %p\n' | sort -rn | head -1 | cut -d' ' -f2-)
  fi
  if [ ! -f "$gif" ]; then
    notify -t 3000 "Recording not found" "${gif:-No GIFs in ~/Videos}"
    return 1
  fi
  # A small picker, not a search: no input line (typing still filters), as
  # tall as its items, the GIF's name above them
  local choice
  choice=$(printf '%s\n' "Show in folder" "Copy GIF" "Copy file" "Open" "Delete" |
    fuzzel --dmenu --hide-prompt --minimal-lines --width 24 \
      --mesg "$(basename "$gif")") || return 0
  case $choice in
    "Show in folder")
      busctl --user call org.freedesktop.FileManager1 /org/freedesktop/FileManager1 \
        org.freedesktop.FileManager1 ShowItems ass 1 "file://$gif" "" >/dev/null
      ;;
    # The image itself, for pasting into chat or a document
    "Copy GIF") wl-copy --type image/gif < "$gif" ;;
    # As a file, for upload fields and file managers
    "Copy file") wl-copy --type text/uri-list "file://$gif" ;;
    Open) setsid -f mpv --loop --title="GIF Preview" "$gif" >/dev/null 2>&1 ;;
    Delete)
      rm -f "$gif" "${gif%.gif}.mp4"
      if [ "$(get_state)" = "done $gif" ]; then set_state idle; fi
      ;;
  esac
}

record() {
  echo $$ > "$dir/pid"
  # Cancelled during the countdown (see toggle)
  trap 'set_state idle; exit 130' TERM

  pkill -x slurp 2>/dev/null || true
  set_state selecting
  local geometry
  if ! geometry=$(slurp); then
    set_state idle
    exit 1
  fi

  for n in 3 2 1; do
    set_state countdown "$n"
    sleep 1
  done
  trap - TERM

  local stamp mp4File gifFile
  stamp=$(date +%m-%d-%Y-%H-%M-%S)
  mp4File="$HOME/Videos/$stamp.mp4"
  gifFile="$HOME/Videos/$stamp.gif"

  # Just the selected region, encoded on the GPU (VA-API, the Radeon's
  # video engine): frames stay in GPU memory from capture to encode, and
  # only screen changes are encoded. AMD's encoder has no low-power mode.
  set_state recording "$(date +%s%3N)"
  wl-screenrec -g "$geometry" --codec avc --low-power=off -f "$mp4File" || true

  if [ ! -s "$mp4File" ]; then
    set_state idle
    notify -t 3000 "Recording failed" "No video file was created"
    exit 1
  fi

  # At 30 fps and the area's on-screen size (slurp's WxH; the MP4 is at
  # the monitor's 1.25x/1.6x), with ordered dithering and a palette from
  # what changes between frames: a 5 s clip converts in ~1 s, against ~14 s
  # for 60 fps at full size with error diffusion, and text stays as sharp.
  set_state converting
  local size=${geometry##* }
  if ! ffmpeg -loglevel error -i "$mp4File" \
    -vf "fps=30,scale=${size%x*}:${size#*x}:flags=lanczos,split[s0][s1];[s0]palettegen=stats_mode=diff[p];[s1][p]paletteuse=dither=bayer:bayer_scale=5:diff_mode=rectangle" \
    -loop 0 "$gifFile"; then
    set_state idle
    notify -t 5000 "GIF conversion failed" "The MP4 is in ~/Videos"
    exit 1
  fi

  # The bar shows "Saved" for a few seconds; the notification (the GIF as
  # its preview) opens the menu when clicked.
  set_state "done" "$gifFile"
  (
    sleep 8
    if [ "$(get_state)" = "done $gifFile" ]; then set_state idle; fi
  ) &
  local action
  action=$(notify -t 20000 -i "$gifFile" -A default=Options --wait \
    "GIF saved" "$(basename "$gifFile")  (click for options)") || true
  if [ "$action" = default ]; then menu "$gifFile"; fi
}

toggle() {
  case $(get_state) in
    recording*) pkill -INT -x wl-screenrec ;;
    selecting*) pkill -x slurp ;;
    countdown*) kill "$(cat "$dir/pid")" 2>/dev/null || set_state idle ;;
    *) record ;;
  esac
}

case ${1:-} in
  "") toggle ;;
  click)
    state=$(get_state)
    case $state in
      "done "*) menu "${state#done }" ;;
      *) toggle ;;
    esac
    ;;
  menu) menu "${2:-}" ;;
  *)
    echo "usage: screen-record [click | menu [GIF]]" >&2
    exit 2
    ;;
esac
