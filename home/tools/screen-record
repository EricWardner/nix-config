# screen-record: record an area to an MP4 in ~/Videos.
#
#   screen-record        start (select, count down, record), or stop or
#                        cancel the recording in progress: Super+R and the
#                        bar's record button
#   screen-record click  the bar's status module: the same, except that a
#                        finished recording opens its preview
#   screen-record menu [MP4]
#                        the preview (capture-preview): the recording
#                        playing, with show in folder, convert to GIF, copy
#                        and delete (the newest recording by default)
#
# The state for the bar (bar-tools record-watch) is one line in
# $XDG_RUNTIME_DIR/screen-record/state, replaced by rename. Each recording's
# on-screen size (slurp's WxH) is kept in sizes/ there, so a GIF made from it
# later comes out at that size rather than the monitor's 1.25x/1.6x.

dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/screen-record"
mkdir -p "$dir/sizes"

set_state() {
  printf '%s\n' "$*" > "$dir/.state"
  mv "$dir/.state" "$dir/state"
}

get_state() {
  cat "$dir/state" 2>/dev/null || echo idle
}

notify() {
  notify-send -a "Screen recording" "$@"
}

menu() {
  local file=${1:-}
  if [ -z "$file" ]; then
    file=$(find "$HOME/Videos" -maxdepth 1 -name '*.mp4' -printf '%T@ %p\n' | sort -rn | head -1 | cut -d' ' -f2-)
  fi
  if [ ! -f "$file" ]; then
    notify -t 3000 "Recording not found" "${file:-No recordings in ~/Videos}"
    return 1
  fi
  local size_file
  size_file="$dir/sizes/$(basename "${file%.*}")"
  if [ -f "$size_file" ]; then
    capture-preview --gif-size "$(cat "$size_file")" "$file" || true
  else
    capture-preview "$file" || true
  fi
  # Deleted from the preview: the bar shouldn't offer it any more
  if [ ! -f "$file" ] && [ "$(get_state)" = "done $file" ]; then set_state idle; fi
}

record() {
  echo $$ > "$dir/pid"
  # Cancelled during the countdown (see toggle)
  trap 'set_state idle; exit 130' TERM
  # Out any other way before the recording's saved: the bar goes back to idle
  trap 'case $(get_state) in selecting* | countdown* | recording*) set_state idle ;; esac' EXIT

  pkill -x slurp 2>/dev/null || true
  set_state selecting
  local geometry
  if ! geometry=$(slurp); then
    set_state idle
    exit 1
  fi

  for n in 3 2 1; do
    set_state countdown "$n"
    sleep 1
  done
  trap - TERM

  local stamp mp4File
  stamp=$(date +%m-%d-%Y-%H-%M-%S)
  mp4File="$HOME/Videos/$stamp.mp4"
  echo "${geometry##* }" > "$dir/sizes/$stamp"

  # Just the selected region, encoded on the GPU (VA-API, the Radeon's
  # video engine): frames stay in GPU memory from capture to encode, and
  # only screen changes are encoded. AMD's encoder has no low-power mode.
  set_state recording "$(date +%s%3N)"
  wl-screenrec -g "$geometry" --codec avc --low-power=off -f "$mp4File" || true

  if [ ! -s "$mp4File" ]; then
    set_state idle
    notify -t 3000 "Recording failed" "No video file was created"
    exit 1
  fi

  # The preview opens straight away; the bar shows "Saved" for a few
  # seconds, which opens it again. No GIF unless the preview's Convert to
  # GIF asks for one.
  set_state "done" "$mp4File"
  (
    sleep 8
    if [ "$(get_state)" = "done $mp4File" ]; then set_state idle; fi
  ) &
  menu "$mp4File"
}

toggle() {
  local state
  state=$(get_state)
  # A recorder killed outright (SIGKILL, a crash) leaves its state behind,
  # with nothing to stop: start over instead
  case $state in
    selecting* | countdown* | recording*)
      kill -0 "$(cat "$dir/pid" 2>/dev/null)" 2>/dev/null || state=idle
      ;;
  esac
  case $state in
    recording*) pkill -INT -x wl-screenrec ;;
    selecting*) pkill -x slurp ;;
    countdown*) kill "$(cat "$dir/pid")" 2>/dev/null || set_state idle ;;
    *) record ;;
  esac
}

case ${1:-} in
  "") toggle ;;
  click)
    state=$(get_state)
    case $state in
      "done "*) menu "${state#done }" ;;
      *) toggle ;;
    esac
    ;;
  menu) menu "${2:-}" ;;
  *)
    echo "usage: screen-record [click | menu [MP4]]" >&2
    exit 2
    ;;
esac
