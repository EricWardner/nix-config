# islands-usage update|mark|report|now|peak|look: what used the CPU, by app, for
# the battery page's lists (shell/BatteryPage.qml): `now` for "right now",
# the rest for "On battery" and "Today" (`peak` finds when an app there was
# busiest, to look at that moment).
#
# below records every cgroup's CPU every 5 s (services.below), but reading
# it back costs about a second of CPU per hour read, too much to do each
# time the page opens. So `update` (a timer, every five minutes) adds what's
# new since its last run to per-app totals in five-minute buckets, and
# `report` sums those. An app is a cgroup: its scope or service, the Docker
# containers, the session (Hyprland). That way processes that come and go
# too fast for below to see one by one still count.
#
# A terminal is the exception: its cgroup is everything run in it. Its CPU
# goes to the jobs run there, a job being the thing that was asked for: up
# from each process through its parents (below records them) to the one
# started from a prompt, by Claude Code, by process-compose and the like,
# seeing through what only wraps a command (timeout, npx, a shell's -c). So
# the browsers a test run starts, and their renderers, count as
# "node:playwright", and a compiler as the "make" or "go" that ran it; what
# hosted the job (the shell, Claude Code, the terminal) has only its own
# CPU. `jobs` below has the rules. An app that a job started in a cgroup of
# its own (a browser does that) is the job's too. What below never saw
# long enough to measure (it needs two samples of a process) goes to the
# jobs that had new processes in that terminal, by how busy each looked,
# and is "terminal" if none did.
#
# Each update also notes whether the charger's in, and so does `mark`, which
# the shell runs the moment it's plugged in or out (shell/Battery.qml). The
# battery can report discharging with the charger in, so UPower's charge
# history can't say when it was unplugged.
#
# Files, in $XDG_CACHE_HOME/islands/usage:
#   cpu.tsv     "<bucket start>\t<app>\t<CPU seconds>", oldest first; each
#               update ends with "<newest sample>\t_last\t0", and "_total"
#               is the whole machine. An app a job turned out to own has a
#               negative line taking back what its cgroup was counted as.
#   power.tsv   "<time>\t<1 on battery, 0 not>\t<level %>"
#   scopes.tsv  "<run-p scope>\t<command>", see name_scope
#   version     which layout cpu.tsv is in, see migrate

dir=${XDG_CACHE_HOME:-$HOME/.cache}/islands/usage
store=/var/log/below/store
# The recorder's own build, so the store's format always matches
below=/run/current-system/sw/bin/below
bucket=300
# below's own retention
keep=$((3 * 24 * 3600))
now=$(date +%s)

mkdir -p "$dir"
touch "$dir/cpu.tsv" "$dir/power.tsv" "$dir/scopes.tsv"

lock() {
  exec 9>"$dir/lock"
  flock "$@" 9
}

# cpu.tsv from before these rules has terminals as one "ghostty", each
# process by its own name, or jobs under names since put right ("pipefail"):
# emptied, so the next update counts the last day again. Call with the
# lock held.
migrate() {
  if [[ $(cat "$dir/version" 2>/dev/null) != 4 ]]; then
    : >"$dir/cpu.tsv"
    echo 4 >"$dir/version"
  fi
}

# gawk's program(comm, cmdline): what a process is, by name. That's its
# command, unless the command only names what runs it (node, which also
# shows as its main thread's name, python, ...): then it's the script, as
# "<runtime>:<script>", so "node:vite" for node_modules/.bin/vite and
# "node:gitnexus" for node_modules/gitnexus/dist/cli/index.js.
# shellcheck disable=SC2016 # awk's own $
program='
  BEGIN {
    runtimes = "^(MainThread|node|nodejs|bun|deno|python[0-9.]*|ruby|perl)$"
  }
  function program(comm, cmdline,    runtime, n, a, i, script, m, part) {
    if (comm !~ runtimes)
      return comm
    n = split(cmdline, a, " ")
    if (comm == "MainThread") {
      # Node names its main thread that, but so may something else
      part = a[1]
      sub(/.*\//, "", part)
      if (part !~ /^(node|nodejs)$/)
        return part == "" ? comm : part
    }
    runtime = comm ~ /^(MainThread|nodejs)$/ ? "node" : comm ~ /^python/ ? "python" : comm
    # The script is the first word that looks like one: a path, or a file
    # of a kind these run. That passes over an option and its value
    # ("--max-old-space-size 4096", "--env-file .env", "bun run"); a
    # preloaded module is a script too, so those options are named. A path
    # with a space in it is cut there: below has the command line joined
    # by spaces.
    script = ""
    for (i = 2; i <= n; i++) {
      if (a[i] == "-m" && runtime == "python" && i < n)
        return runtime ":" a[i + 1]
      # Code given on the command line is no script
      if (a[i] ~ /^(-e|-c|-p|--eval|--print)$/)
        return runtime
      if (a[i] ~ /^-/ || a[i - 1] ~ /^(-r|--require|--import|--loader|--experimental-loader)$/)
        continue
      if (a[i] ~ /\// || a[i] ~ /\.([cm]?[jt]sx?|py|rb|pl)$/) {
        script = a[i]
        break
      }
    }
    if (match(script, /\/node_modules\/\.bin\/([^\/]+)$/, m))
      return runtime ":" m[1]
    if (match(script, /.*\/node_modules\/((@[^\/]+\/)?[^\/]+)\//, m))
      return runtime ":" m[1]
    # The file (less the dot and "-wrapped" of a Nix wrapper), or the
    # nearest folder that says more than "dist/cli/index.js" does
    n = split(script, a, "/")
    for (i = n; i >= 1; i--) {
      part = a[i]
      if (i == n) {
        sub(/\.[cm]?[jt]sx?$|\.py$|\.rb$|\.pl$/, "", part)
        sub(/^\./, "", part)
        sub(/-wrapped$/, "", part)
        if (part ~ /^(index|main|cli|app|server|start|run|__main__)$/)
          continue
      }
      if (part != "" && part !~ /^(bin|dist|lib|src|build|out|cli|\.+)$/)
        return runtime ":" part
    }
    return runtime
  }
'

# gawk's job(pid): the job a process is part of, by name, from a table of
# the processes there are (ppid_of, comm_of and cmd_of, by pid). It goes up
# from the process, parent by parent, as far as the first host: something
# that runs other things without being what was asked for (a shell at its
# prompt, Claude Code, a terminal, tmux, process-compose, systemd). The job
# is the highest process short of that which isn't a wrapper (a shell's
# -c, timeout, env, npx, npm), by its program() name, or its script's for a
# shell script. A host is its own job. inside(pid) says whether anything on
# the way up was in a terminal (group_of, by pid, where there is one).
# child_of, by parent, is one child of each process that has any, and
# top_of, by pid, the process a job is named for, once job() has been asked.
# shellcheck disable=SC2016 # awk's own $
jobs='
  function is_shell(comm) {
    return comm ~ /^-?(zsh|bash|fish|sh|dash|nu)$/
  }
  # What a shell was given to run: "-c" for a command line, its script, or
  # "" for neither. An option that takes a value is passed over with it
  # ("-euo pipefail", "--rcfile file"), and -c may be one option of
  # several ("-lc", "-ec").
  function shell_runs(cmdline,    n, a, i) {
    n = split(cmdline, a, " ")
    for (i = 2; i <= n; i++) {
      if (a[i] ~ /^--(rcfile|init-file)$/ || a[i] ~ /^[-+][A-Za-z]*[oO]$/)
        i++
      else if (a[i] ~ /^-[A-Za-z]*c[A-Za-z]*$/)
        return "-c"
      else if (a[i] !~ /^[-+]/)
        return a[i]
    }
    return ""
  }
  # What a shell is doing: "c" for a command line, "s" for a script, "i" if
  # it has neither, so is at a prompt
  function shell_doing(cmdline,    runs) {
    runs = shell_runs(cmdline)
    return runs == "-c" ? "c" : runs == "" ? "i" : "s"
  }
  function host(comm, cmdline) {
    if (comm ~ /^(\.ghostty-wrappe|ghostty|\.claude-unwrapp|claude|tmux.*|zellij|screen|systemd|\(sd-pam\)|login|sshd.*|greetd|\.Hyprland-wrapp|Hyprland|start-hyprland|process-compose|\.quickshell-wra|quickshell|kthreadd)$/)
      return 1
    return is_shell(comm) && shell_doing(cmdline) == "i"
  }
  function wrapper(comm, cmdline) {
    if (is_shell(comm))
      return shell_doing(cmdline) == "c"
    if (comm ~ /^(timeout|env|sudo|doas|nice|ionice|time|nohup|setsid|xargs|stdbuf|script|watchexec|entr|npx|npm|pnpm|yarn)( |$)/)
      return 1
    return program(comm, cmdline) ~ /^node:(npm|npx|pnpm|yarn|npm-cli|npx-cli|corepack)$/
  }
  function called(comm, cmdline,    script) {
    if (!is_shell(comm) || shell_doing(cmdline) != "s")
      return program(comm, cmdline)
    script = shell_runs(cmdline)
    sub(/.*\//, "", script)
    # One in the Nix store, less its hash
    sub(/^[0-9a-z]{32}-/, "", script)
    sub(/\.(sh|bash|zsh)$/, "", script)
    return script == "" ? comm : script
  }
  # The options of each wrapper that take a value ("sudo -u postgres
  # psql"), by their letters
  BEGIN {
    takes["sudo"] = "ughpCDRTU"
    takes["doas"] = "uC"
    takes["timeout"] = "sk"
    takes["nice"] = "n"
    takes["ionice"] = "cnp"
    takes["env"] = "uCS"
    takes["xargs"] = "nPILsdEa"
    takes["stdbuf"] = "ioe"
    takes["watchexec"] = "ewifsdo"
    takes["npx"] = "pc"
  }
  # A wrapper with nothing under it (seen before what it runs had started,
  # or after it had gone) is named for what it was given to run: its first
  # word that is no option, time or VAR=value. The package managers are
  # themselves then, as the work is their own ("npm ci"), and so is script,
  # whose command is an option of its own.
  function wrapped(comm, cmdline,    tool, m, n, a, i, word) {
    tool = comm
    sub(/ .*/, "", tool)
    if (match(program(comm, cmdline), /^node:(npm|npx|pnpm|yarn|corepack)/, m))
      tool = m[1]
    if (tool ~ /^(npm|pnpm|yarn|corepack|script)$/)
      return tool
    n = split(cmdline, a, " ")
    for (i = 2; i <= n; i++) {
      word = a[i]
      if (word ~ /^-/) {
        if (length(word) == 2 && index(takes[tool], substr(word, 2)))
          i++
        continue
      }
      if (word ~ /^[0-9.]+[smhd]?$/ || word ~ /^[A-Za-z_][A-Za-z0-9_]*=/)
        continue
      sub(/.*\//, "", word)
      sub(/\.(sh|bash|zsh)$/, "", word)
      if (word !~ /^(timeout|env|sudo|doas|nice|ionice|time|nohup|setsid|xargs|stdbuf|npx|exec|x)$/)
        return word
    }
    return ""
  }
  function job(pid,    chain, n, q, parent, i, name) {
    if (pid in job_of)
      return job_of[pid]
    q = pid
    chain[n = 1] = q
    inside_of[pid] = terminal_group(group_of[q])
    while (n < 40) {
      parent = ppid_of[q]
      if (!(parent in comm_of) || host(comm_of[parent], cmd_of[parent]))
        break
      q = parent
      chain[++n] = q
      if (terminal_group(group_of[q]))
        inside_of[pid] = 1
    }
    top_of[pid] = pid
    if (host(comm_of[pid], cmd_of[pid]))
      return job_of[pid] = called(comm_of[pid], cmd_of[pid])
    for (i = n; i > 1; i--)
      if (!wrapper(comm_of[chain[i]], cmd_of[chain[i]]))
        break
    top_of[pid] = chain[i]
    # Nothing but wrappers, this one the lowest: it is part of what it
    # runs (child_of, by parent, has one of its children), or failing
    # that is named for what it was given to run
    name = ""
    if (wrapper(comm_of[pid], cmd_of[pid]) && i == 1) {
      if (pid in child_of) {
        job_of[pid] = job(child_of[pid])
        top_of[pid] = top_of[child_of[pid]]
        return job_of[pid]
      }
      if (!is_shell(comm_of[pid]))
        name = wrapped(comm_of[pid], cmd_of[pid])
    }
    return job_of[pid] = name != "" ? name : called(comm_of[chain[i]], cmd_of[chain[i]])
  }
  function inside(pid) {
    job(pid)
    return inside_of[pid]
  }
  # A Ghostty tab or window
  function terminal_group(path) {
    return path ~ /\/app-ghostty-surface-transient-[0-9]+\.scope$/
  }
'

# gawk's key(path): the app a cgroup is counted as ("" for one that's
# inside another counted already), with the names of the run-p scopes
# (`scopes`, the file) read in. One not named yet keeps its unit name and is
# noted in unnamed_at, with the time `t`. app_group(path) is true of the
# session's own apps, each a scope or service.
# shellcheck disable=SC2016 # awk's own $
keys='
  BEGIN {
    while ((getline line < scopes) > 0) {
      split(line, f, "\t")
      scope[f[1]] = f[2]
    }
  }
  function key(p,    m, n) {
    if (p == "")
      return "_total"
    if (p == "/init.scope")
      return "systemd"
    if (match(p, /^\/system\.slice\/([^\/]+)$/, m)) {
      n = m[1]
      if (n ~ /^docker-.*\.scope$/ || n == "docker.service" || n == "containerd.service")
        return "docker"
      sub(/\.(service|scope|slice)$/, "", n)
      sub(/^system-/, "", n)
      gsub(/\\x2d/, "-", n)
      return n
    }
    if (p ~ /^\/user\.slice\/user-[0-9]+\.slice\/session-[^\/]+\.scope$/)
      return "Hyprland"
    if (p ~ /^\/user\.slice\/user-[0-9]+\.slice\/user@[0-9]+\.service\/init\.scope$/)
      return "systemd"
    if (match(p, /^\/user\.slice\/user-[0-9]+\.slice\/user@[0-9]+\.service\/[^\/]+\.slice\/([^\/]+)$/, m)) {
      n = m[1]
      if (n ~ /^run-p[0-9]+-i[0-9]+\.scope$/) {
        if (n in scope)
          return scope[n]
        if (!(n in unnamed_at))
          unnamed_at[n] = t
        return n
      }
      sub(/\.(service|scope|slice)$/, "", n)
      if (sub(/^app-/, "", n)) {
        # app-<id>@<instance>.service, app-<id>-<pid>.scope
        sub(/@.*$/, "", n)
        sub(/-[0-9]+$/, "", n)
        gsub(/\\x2d/, "-", n)
      }
      return n
    }
    return ""
  }
  function app_group(p) {
    return p ~ /^\/user\.slice\/user-[0-9]+\.slice\/user@[0-9]+\.service\/[^\/]+\.slice\/[^\/]+$/
  }
'

# Every process there is now: "<pid>\t<parent>\t<command>\t<command line>"
# under a heading, in ps's columns, so padded with spaces
processes() {
  ps -e -o $'%p\t%P\t%c\t%a'
}

# This moment's power line, read before waiting on the lock, so a plug
# queued behind an update keeps its own time and state
power() {
  local on level
  on=$(busctl --system get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery) || return 0
  level=$(busctl --system get-property org.freedesktop.UPower /org/freedesktop/UPower/devices/DisplayDevice org.freedesktop.UPower.Device Percentage) || return 0
  # "b true", "d 95.000000"
  printf '%s\t%d\t%.0f\n' "$now" "$([[ $on == "b true" ]] && echo 1 || echo 0)" "${level#d }"
}

# The newest sample counted so far (0 for none)
counted() {
  gawk -F'\t' '$2 == "_last" && $1 > m { m = $1 } END { print m + 0 }' "$dir/cpu.tsv"
}

# Scopes systemd-run makes (run-p<pid>-i<n>.scope: Ghostty, apps the
# launcher starts) say nothing of what's in them, so each is named once for
# its process, from one of below's samples of it: the scope's own PID's
# command, or failing that the commonest ("other" if there's nothing to
# name it by)
name_scope() {
  local unit=$1 t=$2 pid comm
  pid=${unit#run-p}
  pid=${pid%%-*}
  comm=$({ "$below" dump process -b "$t" -e "$((t + 4))" \
    -f pid comm cgroup -O csv 2>/dev/null || true; } |
    gawk -F, -v unit="$unit" -v pid="$pid" '
      substr($3, length($3) - length(unit)) == "/" unit {
        if ($1 == pid)
          own = $2
        n[$2]++
      }
      END {
        if (own == "")
          for (c in n)
            if (n[c] > n[own])
              own = c
        print own == "" ? "other" : own
      }')
  printf '%s\t%s\n' "$unit" "$comm" >>"$dir/scopes.tsv"
}

# Past below's retention, an hour's worth at a time
prune() {
  local f first
  for f in cpu power; do
    read -r first _ <"$dir/$f.tsv" || continue
    if ((first < now - keep - 3600)); then
      gawk -F'\t' -v since=$((now - keep)) '$1 >= since' "$dir/$f.tsv" >"$dir/$f.tsv.new"
      mv "$dir/$f.tsv.new" "$dir/$f.tsv"
    fi
  done
  if (($(wc -l <"$dir/scopes.tsv") > 1000)); then
    tail -n 500 "$dir/scopes.tsv" >"$dir/scopes.tsv.new"
    mv "$dir/scopes.tsv.new" "$dir/scopes.tsv"
  fi
}

# The samples since the last update (or the last day, the first time),
# added to cpu.tsv in one rename, so an update cut short counts nothing
# twice. Call with the lock held.
update() {
  local last unit t from
  power >>"$dir/power.tsv"
  last=$(counted)
  ((last >= now - 24 * 3600)) || last=$((now - 24 * 3600))
  # In Unix time, as below takes it: the local time is two moments in the
  # hour the clocks go back over
  from=$((last + 1))

  # Every cgroup, by app. Scopes not named yet keep their unit name in
  # new.tsv and are listed in unnamed.tsv. The terminals are left out of
  # it: they're shared out among their jobs below, from groups.tsv, which
  # has each sample of every app of the session ("<time>\t<cgroup>\t<CPU
  # seconds>"), a job's own apps among them.
  # shellcheck disable=SC2016 # awk's own $
  { "$below" dump cgroup -b "$from" -e "$now" \
    -f timestamp full_path cpu.usage_pct -O csv 2>"$dir/below.err" || true; } |
    gawk -F, -v last="$last" -v bucket="$bucket" -v scopes="$dir/scopes.tsv" \
      -v unnamed="$dir/unnamed.tsv" -v lengths="$dir/lengths.tsv" -v groups="$dir/groups.tsv" "$jobs$keys"'
      BEGIN {
        prev = last
        printf "" > groups
      }
      NR == 1 { next }
      {
        t = $1 + 0
        if (t <= last)
          next
        # Each sample is the CPU since the one before, usually 5 s; after a
        # sleep, call it 5 s, as what it averages over is unclear
        if (t != prev) {
          step = t - prev <= 30 ? t - prev : 5
          prev = t
          length_of[t] = step
        }
        v = $3
        sub(/%$/, "", v)
        if (v + 0 <= 0)
          next
        used = v / 100 * step
        if (app_group($2))
          printf "%d\t%s\t%.4f\n", t, $2, used > groups
        if (terminal_group($2))
          next
        k = key($2)
        if (k != "")
          cpu[int(t / bucket) * bucket, k] += used
      }
      END {
        for (bk in cpu)
          if (cpu[bk] >= 0.001) {
            split(bk, f, SUBSEP)
            printf "%d\t%s\t%.3f\n", f[1], f[2], cpu[bk]
          }
        if (prev > last)
          printf "%d\t_last\t0\n", prev
        printf "" > unnamed
        for (n in unnamed_at)
          printf "%s\t%d\n", n, unnamed_at[n] > unnamed
        printf "" > lengths
        for (t in length_of)
          printf "%d\t%d\n", t, length_of[t] > lengths
      }' >"$dir/new.tsv"

  # The same samples process by process, to give each terminal's CPU to its
  # jobs (and that of any app whose processes all came from one: it's
  # taken back from the app, which the pass above counted it as). below
  # has a process's CPU only from its second sample on, so one seen once
  # has none: what a terminal used beyond the processes measured is shared
  # among the jobs those were part of, by how busy each looks (see
  # settle). Each sample's length is the one worked out above.
  # shellcheck disable=SC2016 # awk's own $
  { "$below" dump process -b "$from" -e "$now" \
    -f timestamp pid ppid comm state cpu.usage_pct cgroup cmdline -O tsv 2>>"$dir/below.err" || true; } |
    gawk -F'\t' -v last="$last" -v bucket="$bucket" -v scopes="$dir/scopes.tsv" \
      -v lengths="$dir/lengths.tsv" -v groups="$dir/groups.tsv" "$program$jobs$keys"'
      BEGIN {
        while ((getline line < lengths) > 0) {
          split(line, f, "\t")
          length_of[f[1]] = f[2]
        }
        while ((getline line < groups) > 0) {
          split(line, f, "\t")
          group_used[f[1], f[2]] = f[3]
          unsettled[f[1], f[2]] = 1
        }
        at = 0
      }
      # A sample is all in: its groups shared out, and its table cleared
      function settle(    b, step, pid, g, j, total, scale, rest, best, sum) {
        if (at == 0)
          return
        b = int(at / bucket) * bucket
        step = at in length_of ? length_of[at] : 5
        delete procs
        delete ours
        delete known
        delete by_job
        delete unseen
        for (pid in comm_of) {
          g = group_of[pid]
          if (!app_group(g))
            continue
          j = job(pid)
          procs[g]++
          if (inside(pid))
            ours[g]++
          if (cpu_of[pid] == "?") {
            # A whole sample for one that was running as it was taken,
            # nothing for one that was waiting
            unseen[g][j] += state_of[pid] == "RUNNING" ? step : 0
          } else if (cpu_of[pid] > 0) {
            known[g] += cpu_of[pid]
            by_job[g][j] += cpu_of[pid]
          }
        }
        for (g in procs) {
          # An app of its own unless every process in it came from a job
          if (ours[g] != procs[g] || !((at, g) in group_used))
            continue
          total = group_used[at, g]
          delete unsettled[at, g]
          if (!terminal_group(g))
            out[b, key(g)] -= total
          scale = known[g] > total ? total / known[g] : 1
          rest = total - known[g] * scale
          best = ""
          if (g in by_job)
            for (j in by_job[g]) {
              out[b, j] += by_job[g][j] * scale
              if (best == "" || by_job[g][j] > by_job[g][best])
                best = j
            }
          if (rest < 0.0001)
            continue
          # The rest is what the processes not measured used. It goes to
          # the jobs that had new ones, by how busy each looks: what its
          # measured processes used, and the new ones that were running.
          # So a helper that only waits (a sleep in a loop, a tail) takes
          # none of it, and with nothing busy to give it to, it is left as
          # "terminal".
          sum = 0
          if (g in unseen)
            for (j in unseen[g]) {
              if ((g in by_job) && (j in by_job[g]))
                unseen[g][j] += by_job[g][j]
              sum += unseen[g][j]
            }
          if (sum > 0) {
            for (j in unseen[g])
              out[b, j] += rest * unseen[g][j] / sum
          } else
            out[b, terminal_group(g) || best == "" ? "terminal" : best] += rest
        }
        delete ppid_of
        delete comm_of
        delete cmd_of
        delete cpu_of
        delete state_of
        delete group_of
        delete job_of
        delete top_of
        delete inside_of
        delete child_of
      }
      # A row starts with a time and two process IDs. The heading does not,
      # and nor do the further lines of a command line with line breaks in
      # it, which below prints as they are.
      NF < 8 || $1 !~ /^[0-9]+$/ || $2 !~ /^[0-9]+$/ || $3 !~ /^[0-9]+$/ { next }
      {
        t = $1 + 0
        if (t <= last)
          next
        if (t != at) {
          settle()
          at = t
        }
        ppid_of[$2] = $3
        comm_of[$2] = $4
        state_of[$2] = $5
        group_of[$2] = $7
        # "?" for a command line below could not read
        cmd_of[$2] = $8 == "?" ? "" : $8
        if (!($3 in child_of))
          child_of[$3] = $2
        v = $6
        if (v == "?")
          cpu_of[$2] = "?"
        else {
          sub(/%$/, "", v)
          cpu_of[$2] = v / 100 * (t in length_of ? length_of[t] : 5)
        }
      }
      END {
        settle()
        # A terminal that used CPU in a sample with no processes recorded
        for (tg in unsettled) {
          split(tg, f, SUBSEP)
          if (terminal_group(f[2]))
            out[int(f[1] / bucket) * bucket, "terminal"] += group_used[tg]
        }
        for (bk in out)
          if (out[bk] >= 0.001 || out[bk] <= -0.001) {
            split(bk, f, SUBSEP)
            printf "%d\t%s\t%.3f\n", f[1], f[2], out[bk]
          }
      }' >"$dir/programs.tsv"
  # Asleep the whole time is "no samples"; anything else is worth a look
  if [[ -s $dir/below.err ]] && ! grep -q "No samples found" "$dir/below.err"; then
    cat "$dir/below.err" >&2
  fi

  while IFS=$'\t' read -r unit t; do
    name_scope "$unit" "$t"
  done <"$dir/unnamed.tsv"
  {
    cat "$dir/cpu.tsv"
    gawk -F'\t' -v OFS='\t' '
      ARGIND == 1 { scope[$1] = $2; next }
      $2 in scope { $2 = scope[$2] }
      $2 ~ /^run-p/ { $2 = "other" }
      { print }' "$dir/scopes.tsv" "$dir/new.tsv" "$dir/programs.tsv" | sort -n -k1,1 -s
  } >"$dir/cpu.tsv.new"
  mv "$dir/cpu.tsv.new" "$dir/cpu.tsv"
  prune
}

# {"battery": the stretch on battery going on, or the last one of five
#  minutes or more (a charger's blip isn't one), or null, "today": since
#  midnight}, each {"from", "to", "total" CPU seconds, and "apps": [[app,
#  CPU seconds], ...], the most first}; the battery's also "ongoing",
#  "levelFrom" and "levelTo"
report() {
  # Only the minutes since the timer's last run are caught up here; a longer
  # catch-up (the first run's day) is left to the timer, at low priority,
  # and the page shows what's counted meanwhile. Reading needs no lock:
  # cpu.tsv only ever changes by a rename.
  if lock -n; then
    migrate
    if ((now - $(counted) <= 15 * 60)); then
      update
    else
      systemctl --user start --no-block islands-usage.service || true
    fi
  fi
  gawk -F'\t' -v now="$now" -v midnight="$(date -d 'today 00:00' +%s)" -v bucket="$bucket" '
    # Names are only looked up, so what JSON would need escaped goes
    function esc(s) {
      gsub(/[[:cntrl:]\\"]/, "", s)
      return s
    }
    # Back from the newest sample to the last stretch on battery that is
    # going on or lasted five minutes
    function stretch(i, j) {
      done = 1
      for (i = np; i >= 1; i = first - 1) {
        for (; i >= 1 && pon[i] != 1; i--)
          ;
        if (i < 1)
          return
        for (first = i; first > 1 && pon[first - 1] == 1; first--)
          ;
        ongoing = i == np
        from = pt[first]
        to = ongoing ? now : pt[i + 1]
        if (ongoing || to - from >= 300) {
          found = 1
          levelFrom = plevel[first]
          levelTo = ongoing ? plevel[i] : plevel[i + 1]
          return
        }
      }
    }
    # The 40 biggest: names that are one app (the shell merges them) all
    # make it
    function window(name, sums, total, extra, k, n, out) {
      out = ""
      n = 0
      PROCINFO["sorted_in"] = "@val_num_desc"
      for (k in sums) {
        # An app that was a job all along, taken back, comes to nothing
        if (n++ == 40 || sums[k] <= 0)
          break
        out = out (out == "" ? "" : ",") sprintf("[\"%s\",%.1f]", esc(k), sums[k])
      }
      delete PROCINFO["sorted_in"]
      return sprintf("\"%s\":{%s\"total\":%.1f,\"apps\":[%s]}", name, extra, total, out)
    }
    ARGIND == 1 {
      pt[++np] = $1
      pon[np] = $2
      plevel[np] = $3
      next
    }
    !done {
      stretch()
    }
    $2 == "_last" {
      next
    }
    {
      b = $1 + 0
      if ($2 == "_total") {
        if (b >= midnight)
          todayTotal += $3
        if (found && b + bucket > from && b < to)
          batteryTotal += $3
        next
      }
      if (b >= midnight)
        today[$2] += $3
      if (found && b + bucket > from && b < to)
        battery[$2] += $3
    }
    END {
      if (!done)
        stretch()
      if (found)
        out = window("battery", battery, batteryTotal, sprintf("\"from\":%d,\"to\":%d,\"ongoing\":%s,\"levelFrom\":%d,\"levelTo\":%d,", from, to, ongoing ? "true" : "false", levelFrom, levelTo))
      else
        out = "\"battery\":null"
      print "{" out "," window("today", today, todayTotal, sprintf("\"from\":%d,\"to\":%d,", midnight, now)) "}"
    }' "$dir/power.tsv" "$dir/cpu.tsv"
}

# peak FROM TO APP...: the start of the five minutes between those times in
# which the apps (by their names in cpu.tsv) used the most CPU together;
# FROM if they used none
peak() {
  local from=$1 to=$2
  shift 2
  # shellcheck disable=SC2016 # awk's own $
  printf '%s\n' "$@" | gawk -F'\t' -v from="$from" -v to="$to" -v bucket="$bucket" '
    ARGIND == 1 { wanted[$0] = 1; next }
    ($2 in wanted) && $1 + bucket > from && $1 < to { used[$1] += $3 }
    END {
      best = from
      for (b in used)
        if (used[b] > most) {
          most = used[b]
          best = b
        }
      print best + 0 < from + 0 ? from : best
    }' - "$dir/cpu.tsv"
}

# look FROM TO TITLE APP...: a row of the lists looked into, as text for a
# terminal. From cpu.tsv, how much the apps (by their names there) used
# between those times, and when. Then, from below, the processes that were
# part of them in their busiest five minutes, as a tree under what started
# them, with the CPU below measured for each: for a job, the tree is the
# job (a commit, then the hooks it ran, then their linters). The row
# "terminal" has no processes of its own, so it lists the ones seen once in
# the terminals then.
look() {
  local from=$1 to=$2 title=$3 at names
  shift 3
  at=$(peak "$from" "$to" "$@")
  at=$((at / bucket * bucket))
  names=$(printf '%s\034' "$@")
  # shellcheck disable=SC2016 # awk's own $
  gawk -F'\t' -v from="$from" -v to="$to" -v at="$at" -v bucket="$bucket" -v title="$title" \
    -v names="$names" -v scopes="$dir/scopes.tsv" "$program$jobs$keys"'
    BEGIN {
      n = split(names, list, "\034")
      for (i = 1; i <= n; i++)
        if (list[i] != "")
          wanted[list[i]] = 1
      bold = "\033[1m"
      dim = "\033[2m"
      off = "\033[0m"
      split("▁ ▂ ▃ ▄ ▅ ▆ ▇ █", bar, " ")
      SEP = "\035"
    }
    function clock(time,    s) {
      s = strftime("%l:%M %p", time)
      sub(/^ +/, "", s)
      return s
    }
    function amount(v) {
      return v >= 100 ? sprintf("%d", v + 0.5) : sprintf("%.1f", v)
    }
    # How much in all, and a mark for each stretch of the time covered
    function summary(    first, buckets, per, marks, m, b, most, line, v) {
      printf "%s%s%s  %s%s %s to %s%s\n", bold, title, off, dim, strftime("%a", from), clock(from), clock(to), off
      printf "%s CPU-seconds", amount(sum)
      if (all > 0)
        printf ", %s%% of all the CPU used then", amount(100 * sum / all)
      print "\n"
      first = int(from / bucket) * bucket
      buckets = int((to - first + bucket - 1) / bucket)
      per = int((buckets + 71) / 72)
      marks = int((buckets + per - 1) / per)
      for (b in used)
        mark[int((b - first) / bucket / per)] += used[b]
      for (m = 0; m < marks; m++)
        if (mark[m] > most)
          most = mark[m]
      line = ""
      for (m = 0; m < marks; m++) {
        v = mark[m] + 0
        line = line (v <= 0 || most <= 0 ? "·" : bar[1 + int(7.999 * v / most)])
      }
      printf "When %s(each mark %d minutes)%s\n  %s\n", dim, per * bucket / 60, off, line
      if (used[at] > 0)
        printf "  %*s▲ busiest five minutes, from %s: %s CPU-seconds\n", int((at - first) / bucket / per), "", clock(at), amount(used[at])
      print ""
    }
    # A process by name, less the dot and "-wrapped" of a Nix wrapper
    # (".claude-unwrapp", cut short)
    function label(pid,    s) {
      s = called(comm_of[pid], cmd_of[pid])
      if (sub(/^\./, "", s))
        sub(/-(un)?wra?p?p?e?d?$/, "", s)
      return s
    }
    # A sample is all in: its processes that are part of the apps go on the
    # tree, each by the way down to it from the top of its job or app
    function tally(    pid, g, name, top, q, parent, path, guard, cmd, brief) {
      for (pid in comm_of) {
        g = group_of[pid]
        job(pid)
        brief = cpu_of[pid] == "?"
        if (terminal_group(g) || inside_of[pid]) {
          name = ("terminal" in wanted) && brief && terminal_group(g) ? "terminal" : job_of[pid]
          top = top_of[pid]
        } else {
          # An app: its top is as far up as its group goes
          name = key(g)
          top = pid
          for (guard = 0; guard < 40 && (ppid_of[top] in comm_of) && group_of[ppid_of[top]] == g; guard++)
            top = ppid_of[top]
        }
        if (!(name in wanted))
          continue
        path = ""
        q = pid
        for (guard = 0; guard < 40 && q != top; guard++) {
          # What only passes a command on is left out of the way down
          if (q == pid || !wrapper(comm_of[q], cmd_of[q]))
            path = label(q) (path == "" ? "" : SEP path)
          q = ppid_of[q]
          if (!(q in comm_of))
            break
        }
        # A wrapper counted with what it runs is not under that top, but
        # is shown there
        if (q != top)
          path = label(pid)
        path = label(top) (path == "" ? "" : SEP path)
        if (!brief)
          cpu[path] += cpu_of[pid]
        if (++seen[path, pid] == 1)
          count[path]++
        cmd = cmd_of[top] == "" ? comm_of[top] : cmd_of[top]
        if (!brief)
          run_cpu[cmd] += cpu_of[pid]
        if (!((cmd, top) in ran)) {
          ran[cmd, top] = 1
          runs[cmd]++
        }
      }
      delete ppid_of
      delete comm_of
      delete cmd_of
      delete cpu_of
      delete group_of
      delete job_of
      delete top_of
      delete inside_of
      delete child_of
    }
    # A node and what is under it, the biggest first; what is too small to
    # matter is left out, and said to be
    function show(path, lead, last, root,    kid, order, kept, n, k, name, under, rest_cpu, rest_n) {
      name = path
      sub(".*" SEP, "", name)
      printf("%9s %6d  %s%s%s%s\n", (under_cpu[path] > 0 ? amount(under_cpu[path]) : ""), under_n[path], lead, root ? "" : (last ? "└─ " : "├─ "), name, under_brief[path] > 0 && !("terminal" in wanted) ? sprintf("  %s%d brief%s", dim, under_brief[path], off) : "")
      if (!(path in kids) || depth_of[path] >= 7)
        return
      under = root ? "" : lead (last ? "   " : "│  ")
      for (kid in kids[path])
        order[kid] = under_cpu[kid] + under_n[kid] / 1e6
      PROCINFO["sorted_in"] = "@val_num_desc"
      n = 0
      for (kid in order) {
        if (n >= 12 || (under_cpu[kid] < least && n >= 3)) {
          rest_cpu += under_cpu[kid]
          rest_n += under_n[kid]
        } else
          kept[++n] = kid
      }
      delete PROCINFO["sorted_in"]
      for (k = 1; k <= n; k++)
        show(kept[k], under, k == n && rest_n == 0, 0)
      if (rest_n > 0)
        printf("%9s %6d  %s└─ %sothers%s\n", (rest_cpu > 0 ? amount(rest_cpu) : ""), rest_n, under, dim, off)
    }
    ARGIND == 1 {
      if ($1 + bucket <= from || $1 >= to || $2 == "_last")
        next
      if ($2 == "_total")
        all += $3
      else if ($2 in wanted) {
        used[$1] += $3
        sum += $3
      }
      next
    }
    ENDFILE {
      if (ARGIND == 1)
        summary()
    }
    NF < 8 || $1 !~ /^[0-9]+$/ || $2 !~ /^[0-9]+$/ || $3 !~ /^[0-9]+$/ { next }
    {
      if ($1 != sample) {
        tally()
        sample = $1
      }
      ppid_of[$2] = $3
      comm_of[$2] = $4
      group_of[$2] = $7
      cmd_of[$2] = $8 == "?" ? "" : $8
      if (!($3 in child_of))
        child_of[$3] = $2
      v = $6
      if (v != "?") {
        sub(/%$/, "", v)
        v = v / 100 * 5
      }
      cpu_of[$2] = v
    }
    END {
      tally()
      if (length(count) == 0) {
        print "below recorded no processes of it in its busiest five minutes."
        exit
      }
      # A process in one sample only was too brief for below to measure
      for (k in seen)
        if (seen[k] == 1) {
          split(k, f, SUBSEP)
          briefly[f[1]]++
        }
      # Each node with all that is under it
      for (path in count) {
        measured += cpu[path]
        p = path
        while (1) {
          under_cpu[p] += cpu[path]
          under_n[p] += count[path]
          under_brief[p] += briefly[path]
          depth_of[p] = gsub(SEP, SEP, p) + 1
          if (!match(p, ".*" SEP))
            break
          parent = substr(p, 1, RLENGTH - 1)
          kids[parent][p] = 1
          p = parent
        }
        roots[p] = 1
      }
      least = measured / 200
      if ("terminal" in wanted)
        printf "Seen once in the terminals in those five minutes %s(processes too brief to measure, by job)%s\n", dim, off
      else
        printf "In those five minutes %s(CPU-seconds below measured, processes, and how many were too brief to measure)%s\n", dim, off
      for (path in roots)
        order[path] = under_cpu[path] + under_n[path] / 1e6
      PROCINFO["sorted_in"] = "@val_num_desc"
      n = 0
      for (path in order)
        first[++n] = path
      delete PROCINFO["sorted_in"]
      for (i = 1; i <= n && i <= 8; i++)
        show(first[i], "", 1, 1)
      if (!("terminal" in wanted)) {
        print "\nStarted as"
        PROCINFO["sorted_in"] = "@val_num_desc"
        i = 0
        for (cmd in run_cpu) {
          if (++i > 6 || (i > 2 && run_cpu[cmd] < least))
            break
          shown = cmd
          sub(/^\/nix\/store\/[0-9a-z]+-/, "", shown)
          printf("%9s %5s×  %s\n", amount(run_cpu[cmd]), runs[cmd], (length(shown) > 150 ? substr(shown, 1, 149) "…" : shown))
        }
        delete PROCINFO["sorted_in"]
      }
    }' "$dir/cpu.tsv" <({ "$below" dump process -b "$at" -e "$((at + bucket - 1))" \
    -f timestamp pid ppid comm state cpu.usage_pct cgroup cmdline -O tsv 2>/dev/null || true; })
}

case ${1:-} in
  update)
    [[ -d $store && -x $below ]] || exit 0
    lock
    migrate
    update
    ;;
  mark)
    [[ -d $store ]] || exit 0
    line=$(power)
    [[ -n $line ]] || exit 0
    lock
    printf '%s\n' "$line" >>"$dir/power.tsv"
    ;;
  report)
    if [[ -d $store && -x $below ]]; then
      report
    else
      echo '{"battery":null,"today":null}'
    fi
    ;;
  now)
    # "<job>\t<% of one CPU>" over the $2 seconds (2 if not given) that
    # top's second frame covers; its first counts from each process's
    # start. Its config is pointed at nothing, so a saved toprc can't move
    # the columns read. Each process counts towards its job (`jobs`), from
    # the processes there are as top ends.
    frames=$(LC_ALL=C HOME=/var/empty XDG_CONFIG_HOME=/var/empty top -b -n 2 -d "${2:-2}" -w 512)
    # shellcheck disable=SC2016 # awk's own $
    gawk -F'\t' "$program$jobs"'
      ARGIND == 1 {
        pid = $1 + 0
        parent = $2 + 0
        comm = $3
        sub(/ +$/, "", comm)
        if (pid > 0) {
          ppid_of[pid] = parent
          comm_of[pid] = comm
          cmd_of[pid] = $4
          if (!(parent in child_of))
            child_of[parent] = pid
        }
        next
      }
      # top, in columns
      FNR == 1 {
        FS = " "
        $0 = $0
      }
      /^ *PID +USER/ { frame++; next }
      frame == 2 && NF >= 12 && $9 + 0 > 0 && $1 ~ /^[0-9]+$/ {
        comm = $12
        for (i = 13; i <= NF; i++)
          comm = comm " " $i
        if (comm != "top")
          cpu[$1 in comm_of ? job($1) : comm] += $9
      }
      END {
        for (j in cpu)
          printf "%s\t%.1f\n", j, cpu[j]
      }' <(processes) <(printf '%s\n' "$frames")
    ;;
  peak)
    from=${2:?}
    to=${3:?}
    shift 3
    peak "$from" "$to" "$@"
    ;;
  look)
    from=${2:?}
    to=${3:?}
    title=${4:?}
    shift 4
    look "$from" "$to" "$title" "$@"
    ;;
  *)
    echo "usage: islands-usage update|mark|report|now|peak|look" >&2
    exit 2
    ;;
esac
