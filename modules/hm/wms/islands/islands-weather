# islands-weather [--locate]: the forecast for the weather island
# (shell/Weather.qml) in $XDG_CACHE_HOME/islands/weather.json, from
# Open-Meteo. --locate first finds this machine by its IP address (ipbase,
# which only counts a lookup made without a key) and, where the config asks
# (followTimeZone), sets the system to that place's time zone; otherwise the
# place found last time is used.
config=${XDG_CONFIG_HOME:-$HOME/.config}/islands/config.json
unit=$(jq -r '.temperatureUnit // "fahrenheit"' "$config" 2>/dev/null || echo fahrenheit)
follow=$(jq -r '.followTimeZone // false' "$config" 2>/dev/null || echo false)
cache=${XDG_CACHE_HOME:-$HOME/.cache}/islands
place=$cache/place.json
mkdir -p "$cache"

if [[ ${1:-} == --locate || ! -s $place ]]; then
  # An answer with no coordinates (an address it can't place) keeps the
  # place found last time, as a failed lookup does
  if curl -fsS --max-time 10 https://api.ipbase.com/v1/json/ |
    jq -e 'select((.latitude | type) == "number" and (.longitude | type) == "number")
      | {city, loc: "\(.latitude),\(.longitude)", zone: .time_zone}' >"$place.new"; then
    mv "$place.new" "$place"
    # The zone only as the place is found, so one set by hand since (a VPN
    # having put the machine somewhere it isn't) stays until the next
    # lookup. It has to name a zone this system has, and is only set where
    # that's allowed without asking (modules/nixos: a host with no fixed
    # zone).
    zone=$(jq -r '.zone // empty' "$place")
    if [[ $follow == true && $zone =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ && -e /etc/zoneinfo/$zone &&
      $(timedatectl show --property=Timezone --value) != "$zone" ]]; then
      timedatectl --no-ask-password set-timezone "$zone" || true
    fi
  else
    rm -f "$place.new"
    [[ -s $place ]] || exit 1
  fi
fi

IFS=, read -r latitude longitude < <(jq -r .loc "$place")

curl -fsS --max-time 15 --get https://api.open-meteo.com/v1/forecast \
  -d "latitude=$latitude" -d "longitude=$longitude" \
  -d current=temperature_2m,apparent_temperature,weather_code,is_day \
  -d hourly=temperature_2m,precipitation_probability,weather_code,is_day \
  -d daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max \
  -d forecast_hours=13 -d forecast_days=5 \
  -d timezone=auto -d timeformat=unixtime -d "temperature_unit=$unit" |
  jq --slurpfile place "$place" '{
    fetched: now,
    place: $place[0].city,
    lat: ($place[0].loc | split(",")[0] | tonumber),
    lon: ($place[0].loc | split(",")[1] | tonumber),
    now: {
      temp: .current.temperature_2m,
      feels: .current.apparent_temperature,
      code: .current.weather_code,
      day: (.current.is_day == 1)
    },
    hours: [range(.hourly.time | length) as $i | {
      time: .hourly.time[$i],
      temp: .hourly.temperature_2m[$i],
      code: .hourly.weather_code[$i],
      day: (.hourly.is_day[$i] == 1),
      rain: (.hourly.precipitation_probability[$i] // 0)
    }],
    days: [range(.daily.time | length) as $i | {
      time: .daily.time[$i],
      code: .daily.weather_code[$i],
      high: .daily.temperature_2m_max[$i],
      low: .daily.temperature_2m_min[$i],
      rain: (.daily.precipitation_probability_max[$i] // 0)
    }]
  }' >"$cache/weather.json.new"
mv "$cache/weather.json.new" "$cache/weather.json"
