List nearby Wi-Fi networks in nm-applet's main menu, not a submenu.

nm-applet always puts every network but the active one in an
"Available networks" submenu. Rendered by waybar's tray (GTK3 menus
over dbusmenu) on Wayland, that submenu closes whenever the pointer
cuts diagonally across the item below it on the way to a lower
network. Listing the networks inline, below a separator, leaves
nothing to cross.

--- a/src/applet-device-wifi.c
+++ b/src/applet-device-wifi.c
@@ -814,7 +814,6 @@
 	GSList *menu_items = NULL;  /* All menu items we'll be adding */
 	NMNetworkMenuItem *item, *active_item = NULL;
 	GtkWidget *widget;
-	GtkWidget *subitem;
 
 	wdev = NM_DEVICE_WIFI (device);
 	aps = nm_device_wifi_get_access_points (wdev);
@@ -884,29 +883,30 @@
 	if (active_item)
 		menu_items = g_slist_remove (menu_items, active_item);
 
-	subitem = gtk_menu_item_new_with_mnemonic (_("_Available networks"));
-
+	/* List the other networks in the menu itself, below a separator, rather
+	 * than in an "Available networks" submenu. */
 	if (g_slist_length (menu_items)) {
-		GtkWidget *submenu;
-		GSList *sorted_subitems;
+		GSList *sorted_items;
 
-		submenu = gtk_menu_new ();
-		gtk_menu_item_set_submenu (GTK_MENU_ITEM (subitem), submenu);
+		if (active_item || widget) {
+			GtkWidget *separator = gtk_separator_menu_item_new ();
 
-		/* Sort the subitems alphabetically and by importance */
-		sorted_subitems = g_slist_copy (menu_items);
-		sorted_subitems = g_slist_sort (sorted_subitems, sort_by_name);
-		sorted_subitems = g_slist_sort (sorted_subitems, sort_toplevel);
+			gtk_menu_shell_append (GTK_MENU_SHELL (menu), separator);
+			gtk_widget_show (separator);
+		}
 
-		/* Add menu items */
-		for (iter = sorted_subitems; iter; iter = g_slist_next (iter))
-			gtk_menu_shell_append (GTK_MENU_SHELL (submenu), GTK_WIDGET (iter->data));
-		g_slist_free (sorted_subitems);
-	} else
-		gtk_widget_set_sensitive (subitem, FALSE);
+		/* Sort the items alphabetically and by importance */
+		sorted_items = g_slist_copy (menu_items);
+		sorted_items = g_slist_sort (sorted_items, sort_by_name);
+		sorted_items = g_slist_sort (sorted_items, sort_toplevel);
 
-	gtk_menu_shell_append (GTK_MENU_SHELL (menu), subitem);
-	gtk_widget_show_all (subitem);
+		/* Add menu items */
+		for (iter = sorted_items; iter; iter = g_slist_next (iter)) {
+			gtk_menu_shell_append (GTK_MENU_SHELL (menu), GTK_WIDGET (iter->data));
+			gtk_widget_show_all (GTK_WIDGET (iter->data));
+		}
+		g_slist_free (sorted_items);
+	}
 
 out:
 	g_slist_free (menu_items);
